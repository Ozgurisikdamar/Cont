# Python / tooling
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
.env

# Large or regenerable data (rebuild with scripts/download_data.py)
data/raw/
data/processed/embeddings/
data/external/stackexchange/api_cache/
data/external/se_general_eval.jsonl

# Model weights: the trained artifact models/contextlens-topic/ (heads + float16
# fine-tuned encoder) IS committed so a clone runs without retraining
# (decisions.md D-26); intermediate exports and checkpoints are not.
models/finetuned/
models/*.pt
models/*.bin
models/*.safetensors

# Runtime artefacts
*.db
*.db-wal
*.db-shm
logs/
