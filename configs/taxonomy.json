{
  "version": "1.0.0",
  "description": "ContextLens topic taxonomy: 8 general topics, 28 subtopics. Labels are stable snake_case ids; display names are for the UI. 'seeds' are Wikipedia categories written as 'Category_name@max_depth' (DBpedia 'dbc:' names) used to build the training corpus; 'stackexchange' lists (site, tag) pairs used only for the external evaluation set. See docs/TAXONOMY.md.",
  "global_exclude_category_patterns": [
    "(?i)stubs?$",
    "(?i)(^|_)lists?(_|$)",
    "(?i)templates?",
    "(?i)wikipedia",
    "(?i)(^|_)images?(_|$)",
    "(?i)video_games",
    "(?i)(^|_)portals?(_|$)",
    "(?i)redirects?",
    "(?i)disambiguation",
    "(?i)hidden_categories",
    "(?i)articles_",
    "(?i)^works_by_",
    "(?i)_logos?$",
    "(?i)(^|_)people(_|$)",
    "(?i)popular_culture",
    "(?i)fiction",
    "(?i)(^|_)(films?|songs?|albums?|television|anime|manga)(_|$)",
    "(?i)(^|_)(awards?|prizes?)(_|$)"
  ],
  "science_person_exclude_patterns": [
