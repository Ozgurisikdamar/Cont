  "composition": {
    "comment": "Templates used by contextlens.services.composer to turn the active conversation topics into one phrase. 'format' topics (Books) wrap the domain phrase; a 'perspective' topic (History) frames another domain; a topic whose 'broader' topic is also active narrows it.",
    "format_template": "{domain} {format}",
    "format_narrow_template": "{broader} {format} about {narrow}",
    "narrow_template": "{narrow} ({broader})",
    "pair_template": "{a} and {b}"
  }
